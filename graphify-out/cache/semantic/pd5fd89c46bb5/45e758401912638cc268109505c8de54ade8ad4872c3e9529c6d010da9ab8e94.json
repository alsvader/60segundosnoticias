{"nodes": [{"id": "docs_60_segundos_spec_doc", "label": "60 Segundos Noticias \u2014 Master Specification", "file_type": "document", "source_file": "docs/60-segundos-spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_payload_cms", "label": "Payload CMS", "file_type": "concept", "source_file": "docs/60-segundos-spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_nextjs", "label": "Next.js (App Router)", "file_type": "concept", "source_file": "docs/60-segundos-spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_postgresql", "label": "PostgreSQL persistence", "file_type": "concept", "source_file": "docs/60-segundos-spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_source_of_truth_priority", "label": "Source-of-truth conflict priority order", "file_type": "rationale", "source_file": "docs/60-segundos-spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Establishes a deterministic precedence (Master Spec > active OpenSpec change > existing verified implementation > tool/skill guidance > agent judgment) so that when instructions conflict, agents resolve deterministically instead of guessing or introducing a third architecture."}, {"id": "concept_phase_minus_1", "label": "Phase -1 \u2014 AI Development Environment & Repository Bootstrap", "file_type": "concept", "source_file": "docs/60-segundos-spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_acceptance_criteria", "label": "Acceptance Criteria (AC-* normative checklist)", "file_type": "concept", "source_file": "docs/60-segundos-spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_separation_of_responsibilities", "label": "Payload/Next.js separation of responsibilities", "file_type": "rationale", "source_file": "docs/60-segundos-spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Payload decides what content exists and its order; Next.js decides how it looks. This split keeps the CMS from emitting arbitrary CSS/HTML/scripts and keeps presentation logic out of the CMS, preventing an uncontrolled visual builder and preserving a consistent editorial design system."}, {"id": "concept_server_components_default", "label": "React Server Components by default", "file_type": "rationale", "source_file": "docs/60-segundos-spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Minimizes client-side JavaScript and supports progressive enhancement; only components with a genuine browser need (mobile nav, share actions, carousels, accordions) become Client Components."}, {"id": "concept_data_access_layer", "label": "Data Access Layer (src/lib/data)", "file_type": "rationale", "source_file": "docs/60-segundos-spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Centralizing Payload queries in one layer (getPostBySlug, getLatestPosts, searchPosts, etc.) keeps presentational components query-free and allows the backend to be swapped without touching UI components."}, {"id": "concept_block_rendering_pipeline", "label": "Block rendering pipeline (Payload Block \u2192 Resolver \u2192 View Model \u2192 Renderer \u2192 Section)", "file_type": "rationale", "source_file": "docs/60-segundos-spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Separates the CMS schema for a block (manual vs automatic selection) from the rendered UI Section, so a Section never needs to know whether its data came from manual or automatic content selection; unknown blocks log and skip instead of crashing the page."}, {"id": "concept_cache_revalidation", "label": "Tag-based cache and targeted revalidation", "file_type": "rationale", "source_file": "docs/60-segundos-spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Using conceptual cache tags (post:{id}, category:{id}, home, navigation, footer, settings) instead of full rebuilds lets publish/update operations invalidate only the dependent content, while Draft Mode must never serve stale public cache to a previewing editor."}, {"id": "concept_design_system", "label": "60 Segundos editorial Design System", "file_type": "concept", "source_file": "docs/60-segundos-spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_docker_architecture", "label": "Docker Compose app+db architecture", "file_type": "concept", "source_file": "docs/60-segundos-spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_category_theme", "label": "Category color themes and icon keys", "file_type": "concept", "source_file": "docs/60-segundos-spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_editorial_roles", "label": "Admin/Writer roles and permissions", "file_type": "concept", "source_file": "docs/60-segundos-spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_60_segundos_spec_doc", "target": "concept_payload_cms", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/60-segundos-spec.md", "source_location": null,