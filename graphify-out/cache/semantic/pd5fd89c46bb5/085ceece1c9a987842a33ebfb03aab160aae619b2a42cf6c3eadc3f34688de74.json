{"nodes": [{"id": "openspec_specs_category_theme_system_spec_category_theme_system", "label": "Category Theme System (capability)", "file_type": "document", "source_file": "openspec/specs/category-theme-system/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Translates the 10 CMS-stored category theme keys into consumable CSS variables without dynamically interpolated Tailwind classes or arbitrary CMS colors."}, {"id": "openspec_specs_category_theme_system_spec_data_cat_theme_attribute", "label": "data-cat-theme Attribute Mapping Mechanism", "file_type": "rationale", "source_file": "openspec/specs/category-theme-system/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uses a data-attribute selector instead of runtime Tailwind class interpolation so category colors can't become arbitrary/unsafe and stay statically analyzable."}, {"id": "openspec_specs_category_theme_system_spec_cat_css_variables", "label": "--cat-accent / --cat-accent-fg / --cat-soft / --cat-soft-fg / --cat-border", "file_type": "concept", "source_file": "openspec/specs/category-theme-system/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "openspec_specs_category_theme_system_spec_per_theme_contrast", "label": "Explicit Per-theme Contrast Requirement", "file_type": "rationale", "source_file": "openspec/specs/category-theme-system/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "White cannot be assumed as a valid foreground for every theme; light-accent themes (yellow, green, cyan) must define a dark foreground to remain legible."}, {"id": "openspec_specs_category_theme_system_spec_category_theme_keys_constant", "label": "CATEGORY_THEME_KEYS", "file_type": "concept", "source_file": "openspec/specs/cat