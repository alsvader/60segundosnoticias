{"nodes": [{"id": "openspec_specs_shadcn_primitives_spec_shadcn_primitives", "label": "shadcn Primitives Policy (capability)", "file_type": "document", "source_file": "openspec/specs/shadcn-primitives/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Defines the policy governing shadcn/ui as the project's primitive layer: what gets installed per change, how it's retheme, and what must not happen (mass install, generic look, a second UI framework)."}, {"id": "openspec_specs_shadcn_primitives_spec_shadcn_base_policy", "label": "shadcn/ui as Sole Primitive Base", "file_type": "rationale", "source_file": "openspec/specs/shadcn-primitives/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prevents introducing a competing component library (Material UI, Chakra, Ant Design, Mantine) to avoid fragmenting the UI stack."}, {"id": "openspec_specs_shadcn_primitives_spec_incremental_installation", "label": "Incremental, Not Mass Installation", "file_type": "rationale", "source_file": "openspec/specs/shadcn-primitives/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Forbids `shadcn add --all`; a primitive is added only when a concrete editorial component actually consumes it, avoiding speculative bloat for future phases."}, {"id": "openspec_specs_shadcn_primitives_spec_retheming", "label": "Retheming Installed Primitives (no generic shadcn look)", "file_type": "rationale", "source_file": "openspec/specs/shadcn-primitives/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Installed primitives must consume the 60 Segundos Design System tokens (color, radius, typography) instead of keeping shadcn's default neutral oklch appearance."}, {"id": "openspec_specs_shadcn_primitives_spec_no_dark_mode_primitives", "label": "No Inherited Dark Mode in Primitives", "file_type": "rationale", "source_file": "openspec/specs/shadcn-primitives/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Consistent with the absence of dark mode in V1, installed primitives must not expose dark-mode variants or behavior."}, {"id": "openspec_specs_shadcn_primitives_spec_button", "label": "Button (shadcn primitive)", "file_type": "concept", "source_file": "openspec/specs/shadcn-primitives/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "openspec_specs_design_tokens_spec_no_dark_mode", "target": "openspec_specs_shadcn_primitives_spec_no_dark_mode_primitives", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/specs/shadcn-primitives/spec.md", "source_location": null, "weight": 1.0}, {"source": "openspec_specs_shadcn_primitives_spec_shadcn_base_policy", "target": "openspec_specs_shadcn_primitives_spec_shadcn_primitives", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/specs/shadcn-primitives/spec.md", "source_location": null, "weight": 1.0}, {"source": "openspec_specs_shadcn_primitives_spec_incremental_installation", "target": "openspec_specs_shadcn_primitives_spec_shadcn_primitives", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/specs/shadcn-primitives/spec.md", "source_location": null, "weight": 1.0}, {"source": "openspec_specs_shadcn_primitives_spec_retheming", "target": "openspec_specs_shadcn_primitives_spec_shadcn_primitives", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/specs/shadcn-primitives/spec.md", "source_location": null, "weight": 1.0}, {"source": "openspec_specs_shadcn_p