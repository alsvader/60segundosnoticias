    {
      "id": "concept_block_rendering_pipeline",
      "label": "Block rendering pipeline (Payload Block \u2192 Resolver \u2192 View Model \u2192 Renderer \u2192 Section)",
      "author": null,
      "captured_at": null,
      "community": 0,
      "community_name": "Product Architecture Spec",
      "contributor": null,
      "file_type": "rationale",
      "norm_label": "block rendering pipeline (payload block \u2192 resolver \u2192 view model \u2192 renderer \u2192 section)",
      "rationale": "Separates the CMS schema for a block (manual vs automatic selection) from the rendered UI Section, so a Section never needs to know whether its data came from manual or automatic content selection; unknown blocks log and skip instead of crashing the page.",
      "source_file": "docs/60-segundos-spec.md",
      "source_location": null,
      "source_url": null
    },
    {
      "id": "concept_cache_revalidation",
      "label": "Tag-based cache and targeted revalidation",
      "author": null,
      "captured_at": null,
      "community": 0,
      "community_name": "Product Architecture Spec",
      "contributor": null,
      "file_type": "rationale",
      "norm_label": "tag-based cache and targeted revalidation",
      "rationale": "Using conceptual cache tags (post:{id}, category:{id}, home, navigation, footer, settings) instead of full rebuilds lets publish/update operations invalidate only the dependent content, while Draft Mode must never serve stale public cache to a previewing editor.",
      "source_file": "docs/60-segundos-spec.md",
      "source_location": null,
      "source_url": null
    },
    {
      "id": "concept_data_access_layer",
      "label": "Data Access Layer (src/lib/data)",
      "author": null,
      "captured_at": null,
      "community": 0,
      "community_name": "Product Architecture Spec",
      "contributor": null,
      "file_type": "rationale",
      "norm_label": "data access layer (src/lib/data)",
      "rationale": "Centralizing Payload queries in one layer (getPostBySlug, getLatestPosts, searchPosts, etc.) keeps presentational components query-free and allows the backend to be swapped without touching UI components.",
      "source_file": "docs/60-segundos-spec.md",
      "source_location": null,
      "source_url": null
    },
    {
      "id": "concept_separation_of_responsibilities",
      "label": "Payload/Next.js separation of responsibilities",
      "author": null,
      "captured_at": null,
      "community": 0,
      "community_name": "Product Architecture Spec",
      "contributor": null,
      "file_type": "rationale",
      "norm_label": "payload/next.js separation of responsibilities",
      "rationale": "Payload decides what content exists and its order; Next.js decides how it looks. This split keeps the CMS from emitting arbitrary CSS/HTML/scripts and keeps presentation logic out of the CMS, preventing an uncontrolled visual builder and preserving a consistent editorial design system.",
      "source_file": "docs/60-segundos-spec.md",
      "source_location": null,
      "source_url": null
    },
    {
      "id": "concept_server_components_default",
      "label": "React Server Components by default",
      "author": null,
      "captured_at": null,
      "community": 0,
      "community_name": "Product Architecture Spec",
      "contributor": null,
      "file_type": "rationale",
      "norm_label": "react server components by default",
      "rationale": "Minimizes client-side JavaScript and supports progressive enhancement; only components with a genuine browser need (mobile nav, share actions, carousels, accordions) become Client Components.",
      "source_file": "docs/60-segundos-spec.md",
      "source_location": null,
      "source_url": null
    },
