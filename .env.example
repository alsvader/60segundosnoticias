# PostgreSQL
DATABASE_URI=postgres://postgres:postgres@db:5432/60segundos
POSTGRES_DB=60segundos
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Payload
PAYLOAD_SECRET=

# Next.js
# NEXT_PUBLIC_SITE_URL: required in production, optional in development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Preview / revalidation
# PREVIEW_SECRET: required in production, optional in development.
PREVIEW_SECRET=
# REVALIDATION_SECRET: reserved/optional in every environment. Cache
# invalidation currently runs in-process (Payload hooks call revalidateTag
# directly), so there is no external revalidation endpoint that consumes
# this value yet.
REVALIDATION_SECRET=

# Object storage (S3-compatible) - required in production, optional in
# development (Media falls back to local storage when unset).
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
