{
  "ci": {
    "collect": {
      "numberOfRuns": 3,
      "staticDistDir": null,
      "url": [
        "http://localhost:3100/",
        "http://localhost:3100/fixture-noticias",
        "http://localhost:3100/fixture-noticias/fixture-post-publicado",
        "http://localhost:3100/fixture-page",
        "http://localhost:3100/buscar?q=fixture",
        "http://localhost:3100/fixture-noticias/fixture-post-embed"
      ],
      "settings": {
        "preset": "desktop"
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "^http://localhost:3100/(fixture-noticias(/fixture-post-publicado)?|fixture-page)?$",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.85 }],
            "categories:accessibility": ["error", { "minScore": 0.95 }],
            "categories:best-practices": ["error", { "minScore": 0.95 }],
            "categories:seo": ["error", { "minScore": 0.95 }],
            "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
            "total-blocking-time": ["error", { "maxNumericValue": 200 }]
          }
        },
        {
          "matchingUrlPattern": "^http://localhost:3100/buscar\\?q=fixture$",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.85 }],
            "categories:accessibility": ["error", { "minScore": 0.95 }],
            "categories:best-practices": ["error", { "minScore": 0.95 }],
            "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
            "total-blocking-time": ["error", { "maxNumericValue": 200 }],
            "categories:seo": ["warn", { "minScore": 0.95 }]
          }
        },
        {
          "matchingUrlPattern": "^http://localhost:3100/fixture-noticias/fixture-post-embed$",
          "assertions": {
            "categories:performance": ["warn", { "minScore": 0.85 }],
            "categories:accessibility": ["warn", { "minScore": 0.95 }],
            "categories:best-practices": ["warn", { "minScore": 0.95 }],
            "categories:seo": ["warn", { "minScore": 0.95 }],
            "largest-contentful-paint": ["warn", { "maxNumericValue": 2500 }],
            "cumulative-layout-shift": ["warn", { "maxNumericValue": 0.1 }],
            "total-blocking-time": ["warn", { "maxNumericValue": 200 }]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./.lighthouseci"
    }
  }
}
