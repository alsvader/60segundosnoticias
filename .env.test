# Valores de prueba, NUNCA productivos. Ver docs/TESTING.md.
#
# El sufijo `_test` y el puerto 5433 son el marcador que
# tests/setup/assert-test-database.ts exige antes de permitir cualquier
# operación destructiva (reset/drop) contra esta base de datos. No cambiar
# el nombre de la base ni el puerto sin actualizar ese guard.

# PostgreSQL de pruebas (ver compose.test.yml)
DATABASE_URI=postgres://postgres:postgres@localhost:5433/60segundos_test
POSTGRES_DB=60segundos_test
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Payload (secretos de mentira, nunca reutilizar valores reales)
PAYLOAD_SECRET=test-only-payload-secret-DevOnlyPass123
PREVIEW_SECRET=test-only-preview-secret-DevOnlyPass123
REVALIDATION_SECRET=test-only-revalidation-secret-DevOnlyPass123

# Next.js
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Object storage: sin configurar a propósito - Media usa el fallback a
# almacenamiento local en pruebas (ver design.md, Decisión 3 del proposal).
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
