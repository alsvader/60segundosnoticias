{
  "name": "60-segundos-noticias",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "migrate:create": "payload migrate:create",
    "migrate": "payload migrate",
    "seed:initial": "payload run src/payload/seed/initial.ts",
    "seed:dev": "payload run src/payload/seed/dev.ts",
    "test": "pnpm typecheck && pnpm lint && pnpm test:importmap && pnpm test:unit",
    "test:unit": "vitest --run --project=node --project=happy-dom tests/setup tests/fixtures src",
    "test:importmap": "bash scripts/verify-importmap.sh",
    "test:migrations": "node --env-file=.env.test scripts/run-migration-chain.ts",
    "test:integration": "node --env-file=.env.test scripts/run-migration-chain.ts && vitest --run --project=integration",
    "test:e2e": "playwright test",
    "test:e2e:pr": "playwright test 'tests/e2e/(?!visual\\.spec\\.ts)' --project=chromium",
    "test:e2e:server": "node scripts/run-e2e-server.mjs",
    "test:a11y": "playwright test tests/e2e/a11y.spec.ts",
    "test:visual": "playwright test tests/e2e/visual.spec.ts --project=chromium",
    "test:smoke": "bash scripts/docker-smoke.sh",
    "test:docker-isolation": "bash scripts/verify-docker-isolation.sh"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.87.1",
    "@payloadcms/next": "3.87.1",
    "@payloadcms/plugin-search": "3.87.1",
    "@payloadcms/richtext-lexical": "3.87.1",
    "@payloadcms/storage-s3": "3.87.1",
    "@payloadcms/translations": "3.87.1",
    "@vidstack/react": "1.15.6",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "graphql": "^16.14.2",
    "lucide-react": "^1.43.0",
    "next": "16.3.3",
    "payload": "3.87.1",
    "pg": "8.20.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-social-media-embed": "^2.5.18",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "sharp": "0.35.4",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.5.0",
    "@types/pg": "8.20.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "happy-dom": "^20.14.5",
    "lighthouse": "^13.4.1",
    "postcss": "^8.5.28",
    "sass": "^1.104.0",
    "tailwindcss": "4.1.18",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@parcel/watcher",
      "unrs-resolver"
    ]
  }
}
